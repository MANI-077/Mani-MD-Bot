# ==========================================
# ᴍᴀɴɪ ᴍᴅ ☘ - Environment Variables Template
# ==========================================

# 1. SERVER CONFIGURATION
PORT=3000
RENDER_EXTERNAL_URL=https://your-bot-name.onrender.com
APP_URL=https://your-bot-name.onrender.com

# 2. GITHUB SESSION SYNC (CRITICAL)
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# 3. BOT CONFIGURATION
SESSION_ID=mani_md_session
UPDATE_ZIP_URL=

# 4. API KEYS (Optional - See config.js)
# LOLHUMAN_API_KEY=
# XTEAM_API_KEY=
# NEOXR_API_KEY=
